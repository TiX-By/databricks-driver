{
    "name": "tixby/databricks-driver",
    "description": "Laravel Eloquent database driver for Databricks SQL warehouses via the Statement Execution API",
    "keywords": [
        "laravel",
        "databricks",
        "eloquent",
        "unity-catalog"
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "TixBy\\Databricks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TixBy\\Databricks\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TixBy\\Databricks\\DatabricksServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
